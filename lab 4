def f1(x):
    return x**3 - 12*x - 8

def f2(x):
    return x**3 + 4*x - 6

def f1_prime(x):
    return 3*x**2 - 12

def f2_prime(x):
    return 3*x**2 + 4

def bisection_method(f, a, b, tol=1e-6, max_iter=100):

    iterations = []
    if f(a) * f(b) > 0:
        raise ValueError("f(a) и f(b) должны иметь разные знаки!")
    
    for i in range(max_iter):
        c = (a + b) / 2
        fc = f(c)
        
        iterations.append({
            'iteration': i + 1,
            'a': a,
            'b': b,
            'c': c,
            'f(c)': fc,
            'error': b - a
        })
        
        if abs(fc) < tol or abs(b - a) < tol:
            return
